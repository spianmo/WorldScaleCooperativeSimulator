{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "World Scale Cooperative Simulator",
  "version": "0.1.0",
  "identifier": "com.teamhelper.worldscale.cooperative.simulator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "world-simulator",
        "title": "物理世界仿真场景",
        "url": "index.html#/world",
        "width": 1920,
        "height": 1080,
        "minWidth": 1440,
        "minHeight": 900,
        "resizable": true,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "macOS": {
      "entitlements": "./Entitlements.plist"
    }
  }
}
